DATABASE_URL=postgresql://storyforge:storyforge@localhost:5432/storyforge

# Anthropic (story / scene / shot analysis)
ANTHROPIC_API_KEY=
# Verify this model slug is available to your key in the Anthropic console; adjust if needed.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (storyboard frame image generation)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Hugging Face (free-tier open-source image generation, for testing without
# burning paid credits — get a token at https://hf.co/settings/tokens)
HUGGINGFACE_API_KEY=
# Visit https://huggingface.co/stabilityai/stable-diffusion-3-medium-diffusers
# and click "Agree" once (logged in as the account that owns the token above)
# before this will work — it's gated but auto-approved.
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Provider selection (seam for swapping providers later)
AI_LLM_PROVIDER=anthropic
# "openai" (paid, gpt-image-1) or "huggingface" (free tier, open-source models)
AI_IMAGE_PROVIDER=openai

# Pre-launch access gate (src/proxy.ts) for the actual app — /dashboard,
# /projects/*, and the AI-generation API routes. The public landing page and
# /api/waitlist are never gated. Leave both unset to keep the gate off
# (default, e.g. for local dev); set both in production to require this
# HTTP Basic Auth login before the app itself is reachable.
APP_ACCESS_USER=
APP_ACCESS_PASSWORD=

# Public site URL, used by robots.ts/sitemap.ts. Set to your real domain once live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob storage for generated frame images (src/lib/storage/local.ts).
# Leave unset for local dev (writes to public/generated/ instead). Required in
# production — Vercel's serverless filesystem is ephemeral, so without this,
# generated images would vanish after the request finishes. Auto-populated
# when you attach a Blob store to the Vercel project (Storage tab); copy its
# value into the project's env vars if it isn't linked automatically.
BLOB_READ_WRITE_TOKEN=
