generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  ANALYZED
  STORYBOARDED
}

enum FrameStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Project {
  id          String        @id @default(cuid())
  title       String
  idea        String
  genre       String?
  tone        String?
  visualStyle String        @default("Cinematic")
  aspectRatio String        @default("16:9")
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  characters Character[]
  scenes     Scene[]
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String
  createdAt   DateTime @default(now())

  scenes Scene[] @relation("SceneCharacters")

  @@index([projectId])
}

model Scene {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber Int
  title       String
  location    String
  timeOfDay   String?
  mood        String?
  duration    Int?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters Character[] @relation("SceneCharacters")
  shots      Shot[]

  @@index([projectId])
}

model Shot {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotNumber  Int
  shotType    String
  cameraAngle String?
  lens        String?
  movement    String?
  duration    Int?
  description String
  dialogue    String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  frame Frame?

  @@index([sceneId])
}

model Frame {
  id           String      @id @default(cuid())
  shotId       String      @unique
  shot         Shot        @relation(fields: [shotId], references: [id], onDelete: Cascade)
  imageUrl     String?
  promptUsed   String?
  status       FrameStatus @default(QUEUED)
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  note      String?
  createdAt DateTime @default(now())
}
